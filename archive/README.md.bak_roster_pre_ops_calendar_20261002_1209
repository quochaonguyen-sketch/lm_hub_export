py -3.14 export_lm_hubs.py --apis roster --hubs data\smoke\_hubs_smoke_roster.csv --out-suffix _smoke
py -3.14 export_lm_hubs.py --apis event_list --hubs data\smoke\_hubs_smoke_roster.csv --out-suffix _smoke
