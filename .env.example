# Sheet IDs for lm_hub_export.
# This project does NOT load .env automatically. Set them in the shell:
#   set LM_HUB_ROSTER_SHEET_ID=your_spreadsheet_id
#   setx LM_HUB_GOOGLE_SHEET_ID your_spreadsheet_id
# Empty or unset = built-in default spreadsheet
# 1_tgFNXYfbNoz3OF8sqD9QIwazwvjT6Va_OpxmbdZFEQ
# A per-tab var overrides the shared ID for that tab only.
# --google-sheet-id still overrides every tab.

# Shared spreadsheet (all tabs) when a per-tab var is unset.
LM_HUB_GOOGLE_SHEET_ID=
GOOGLE_SHEET_ID=

# Optional per-tab spreadsheet IDs.
LM_HUB_ROSTER_SHEET_ID=
ROSTER_SHEET_ID=
LM_HUB_BACKLOG_SHEET_ID=
BACKLOG_SHEET_ID=
LM_HUB_DELIVERY_PROGRESS_SHEET_ID=
DELIVERY_PROGRESS_SHEET_ID=
LM_HUB_ORDER_VOLUME_SHEET_ID=
ORDER_VOLUME_SHEET_ID=
